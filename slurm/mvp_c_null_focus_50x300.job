#!/bin/bash
#SBATCH --job-name=mvp_c_null_50x300
#SBATCH --account=erhodes_44
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=48:00:00
#SBATCH --output=/scratch1/dongpoba/gong_lag_v4/mvp_c_hmi_degradation/runs/null_focus_50x300/logs/slurm/mvp_c_null_focus_50x300_%j.out

set -euo pipefail

export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

echo "=========================================="
echo "SLURM_JOB_ID = ${SLURM_JOB_ID}"
echo "SLURM_JOB_NODELIST = ${SLURM_JOB_NODELIST}"
echo "SLURM_CPUS_PER_TASK = ${SLURM_CPUS_PER_TASK}"
echo "TMPDIR = ${TMPDIR:-}"
echo "=========================================="

cd /scratch1/dongpoba/gong_lag_v4_git_backup

SCRIPT=/scratch1/dongpoba/gong_lag_v4_git_backup/gong_lag_v4_mvp_c_hmi_degradation_injection.py
HMI_BIN_TIMESERIES=/scratch1/dongpoba/gong_lag_v4/inputs/hmi/3day_extended_bins.csv
GONG_RUN=/scratch1/dongpoba/gong_lag_v4/q1_splitting_validation/runs/q1_prod_hmi2010_split_auto_all

OUTROOT=/scratch1/dongpoba/gong_lag_v4/mvp_c_hmi_degradation/runs/null_focus_50x300
OUTDIR=${OUTROOT}/job_${SLURM_JOB_ID}

mkdir -p "${OUTDIR}"

python3 "${SCRIPT}" \
  --hmi-bin-timeseries="${HMI_BIN_TIMESERIES}" \
  --hmi-format=extended_bins_12 \
  --gong-run="${GONG_RUN}" \
  --outdir="${OUTDIR}" \
  --freq-min=2000 \
  --freq-max=4500 \
  --bin-widths=250,500 \
  --focus-bin-low=3000 \
  --focus-bin-high=3500 \
  --degradation-kernel-days=9 \
  --target-stride-days=3 \
  --detrend-days=81 \
  --inject-lags-hours=0,6,12 \
  --n-injection-realizations=50 \
  --noise-model=gaussian_covariance \
  --covariance-scale=1.0 \
  --lag-search-hours=-72,72 \
  --lag-step-hours=72 \
  --bootstrap-n=300 \
  --bootstrap-block-days=108 \
  --random-seed=20260610 \
  --overwrite \
  --log-level=INFO
